package systems

templ ConsoleView() {
	<div id="console">
		<div class="console-body" id="console-body" ref="body">
			<div class="console-content" id="console-content" ref="content">
				<p id="console-logs" ref="logs"></p>
			</div>
			<input class="console-input" id="console-input" ref="input" type="text" autocomplete="off"/>
		</div>
	</div>
}
