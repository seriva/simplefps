package systems

templ ConsoleView() {
	<div id="console">
		<div class="console-body" id="console-body">
			<div class="console-content" id="console-content">
				<p id="console-logs"></p>
			</div>
			<input class="console-input" id="console-input" type="text" autocomplete="off"/>
		</div>
	</div>
}
