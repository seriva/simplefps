package systems

css statsStyle() {
	margin: 0;
	padding: 0;
	background-color: transparent;

	& .stats-item {
		display: none;
	}
	& .stats-item.visible {
		display: block;
	}
	& #stats-basic {
		font-size: 12px;
		color: #fff;
		left: 8px;
		top: 8px;
		z-index: 2001;
		position: absolute;
	}
	& #stats-scene {
		font-size: 12px;
		color: #fff;
		left: 8px;
		top: 24px;
		z-index: 2001;
		position: absolute;
	}
	& #stats-pos {
		color: #fff;
		font-size: 12px;
		left: 8px;
		top: 40px;
		z-index: 2001;
		position: absolute;
	}
}

templ StatsView(visible *gom.Signal[bool], basic, scene, pos *gom.Signal[string]) {
	<div id="stats" class={ statsStyle() }>
		<div id="stats-basic" class={ statsItemClass(visible.Get()) }><span id="stats-basic-text">{ basic }</span></div>
		<div id="stats-scene" class={ statsItemClass(visible.Get()) }><span id="stats-scene-text">{ scene }</span></div>
		<div id="stats-pos" class={ statsItemClass(visible.Get()) }><span id="stats-pos-text">{ pos }</span></div>
	</div>
}
